# Copia este archivo a .streamlit/secrets.toml (está en .gitignore) y rellénalo.
# Guía completa: docs/DESPLIEGUE.md

[auth]
# URL pública del dashboard + /oauth2callback. En local: http://localhost:8501/oauth2callback
redirect_uri = "https://nba.tu-dominio.com/oauth2callback"
# Cadena aleatoria larga: python -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = "CAMBIAR"
# Credenciales OAuth de Google Cloud (APIs y servicios → Credenciales → ID de cliente web)
client_id = "CAMBIAR.apps.googleusercontent.com"
client_secret = "CAMBIAR"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[acceso]
# Solo estos correos pueden usar el dashboard.
correos = ["tu-correo@gmail.com"]
